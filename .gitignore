# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env

# MacOS
.DS_Store

# Raw video archives (track in DVC/external storage, not git).
# Sidecar observation JSONs (one per video, same stem) ARE tracked.
# Note: gitignore CANNOT un-ignore files inside an ignored directory, so we
# ignore the directory CONTENTS (datasets/*) instead of the directory itself,
# then re-include *.json. Without this, hand-edited sidecars stay invisible
# to git and can be silently overwritten by tooling.
datasets/*
!datasets/*.json

# Transient experiment outputs
benchmarks/

# Pipeline-regenerable artefacts (regenerated by `uv run python -m optics.<module>`)
docs/optics/figures/_thumb_*.png
docs/optics/crystal_observations.csv
